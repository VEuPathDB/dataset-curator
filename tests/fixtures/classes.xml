      <getAndUnpackOutput file="@@dataDir@@/final/samplesheet.csv"/>
      <pluginArgs>--dbRefExternalDatabaseSpec "%DATASET_NAME%|%DATASET_VERSION%"</pluginArgs>
    </datasetLoader>
